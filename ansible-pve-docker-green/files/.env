# dnsweaver on by default - profile-gated rather than unconditional so a
# fresh bootstrap without the Technitium token provisioned yet doesn't fail
# to start, but on by default so a rebuild doesn't silently lose DNS
# automation with no obvious signal anything's missing. Omit (empty string)
# or override at the CLI (--profile "") to skip it for that edge case.
COMPOSE_PROFILES=dnsweaver
