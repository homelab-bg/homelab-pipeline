---
# Copy to hosts.yml and fill in real values - hosts.yml is gitignored.
all:
  children:
    swarm:
      hosts:
        docker-worker-3001:
          ansible_host: 192.168.0.31
        docker-worker-3002:
          ansible_host: 192.168.0.32
        docker-worker-3003:
          ansible_host: 192.168.0.33
      children:
        # Not a permanent leader - all 3 nodes end up as swarm managers. This just
        # picks which one runs `swarm init` first; see swarm-init.yml / swarm-join.yml.
        bootstrap:
          hosts:
            docker-worker-3001:
  vars:
    ansible_user: ubuntu
    ansible_python_interpreter: /usr/bin/python3
    # No ansible_ssh_private_key_file here on purpose - auth relies on whoever's
    # running this having a matching key available (ssh-agent, or a `Host 192.168.0.3*`
    # block in ~/.ssh/config), not a path hardcoded into the inventory.
